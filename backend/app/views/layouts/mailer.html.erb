<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
      body {
        margin: 0;
        padding: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        background-color: #ffffff;
        color: #1a1a1a;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }
      .email-wrapper {
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
        padding: 40px 20px;
      }
      .logo {
        margin-bottom: 32px;
        color: #2563eb;
        font-weight: 700;
        font-size: 20px;
        letter-spacing: -0.02em;
        text-decoration: none;
      }
      .content {
        font-size: 16px;
        font-weight: 400;
        color: #4b5563;
        margin-bottom: 32px;
      }
      .content strong {
        color: #111827;
      }
      .cta-container {
        margin-bottom: 48px;
      }
      .button {
        display: inline-block;
        background-color: #2563eb;
        color: #ffffff !important;
        padding: 14px 28px;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 16px;
        text-align: center;
      }
      .footer {
        padding-top: 32px;
        border-top: 1px solid #f3f4f6;
        font-size: 13px;
        color: #9ca3af;
      }
      .footer p {
        margin: 4px 0;
      }
      .footer a {
        color: #9ca3af;
        text-decoration: underline;
      }
      @media only screen and (max-width: 600px) {
        .email-wrapper {
          padding: 24px 16px;
        }
      }
    </style>
  </head>
  <body>
    <div class="email-wrapper">
      <div class="logo">
        Vault.ai
      </div>

      <div class="content">
        <%= yield %>
      </div>

      <div class="footer">
        <p>© 2024 Vault — Your digital safe for warranties.</p>
        <p>This is an automated system message.</p>
        <p>
          <a href="<%= notification_preferences_url %>">Manage email preferences or unsubscribe</a>
        </p>
      </div>
    </div>
  </body>
</html>
