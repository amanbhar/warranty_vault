# Database Configuration
DATABASE_URL=postgresql://localhost:5432/warranty_vault_api_development
DB_USERNAME=postgres
DB_HOST=localhost

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Secret (generate your own: openssl rand -hex 64)
JWT_SECRET=your_jwt_secret_key_here

# Google Cloud Vision (for OCR)
GOOGLE_PROJECT_ID=your_project_id
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
# For Docker Compose local dev, the browser must be redirected back to the backend.
GOOGLE_REDIRECT_URI=http://localhost:3005/auth/google/callback
GOOGLE_APPLICATION_CREDENTIALS=config/credentials/ocr.json

# Application Settings
RAILS_MAX_THREADS=5
RAILS_ENV=development

# Frontend URL (for CORS and OAuth redirects)
FORCE_SSL=false
FRONTEND_URL=http://localhost:3006

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_TOKENS=2000

# OpenAI Configuration (Backup)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=2000

# AI Service Selection
PRIMARY_AI_SERVICE=gemini
FALLBACK_AI_SERVICE=openai

# SMTP Configuration
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USER_NAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=Warranty Vault <noreply@warrantyvault.com>
DELIVERY_METHOD=smtp
